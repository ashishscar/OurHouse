{
  "name": "ourhouse-care",
  "main": "./entry.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAINTENANCE",
        "class_name": "OurHouseMaintenance"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ourhouse-maintenance-v1",
      "new_sqlite_classes": [
        "OurHouseMaintenance"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
